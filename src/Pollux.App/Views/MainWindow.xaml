<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Pollux.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Pollux.App.Views"
    xmlns:vm="using:Pollux.App.ViewModels"
    Title="Pollux">

    <Grid x:Name="Root" PreviewKeyDown="Root_PreviewKeyDown" Background="{ThemeResource PolluxChromeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="TitleBar" Padding="12,0,150,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock FontFamily="{StaticResource PolluxMono}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                    <Run Text="pollux" /><Run x:Name="LogoCursor" Text="_" Foreground="{ThemeResource PolluxAccentBrush}" />
                </TextBlock>
                <Border x:Name="AdminBadge" Visibility="Collapsed" Background="{ThemeResource PolluxBadBrush}" CornerRadius="3" Padding="6,1">
                    <TextBlock Text="ADMIN" FontFamily="{StaticResource PolluxMono}" FontSize="10" FontWeight="Bold" Foreground="White" />
                </Border>
                <TextBlock x:Name="TitlePath" FontFamily="{StaticResource PolluxMono}" FontSize="12" Foreground="{ThemeResource PolluxMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid x:Name="Body" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="SidebarHost" Padding="8,0,6,8" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SidebarPanel" Spacing="1" />
            </ScrollViewer>
            <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition x:Name="TerminalRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid x:Name="PanesGrid" ColumnSpacing="6" Margin="0,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="SecondPaneColumn" Width="*" />
                    <ColumnDefinition x:Name="PreviewPaneColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <views:PaneView x:Name="Pane1" />
                <views:PaneView x:Name="Pane2" Grid.Column="1" />
                <Border x:Name="PreviewPane" Grid.Column="2" Visibility="Collapsed" CornerRadius="8,8,0,0" BorderThickness="1"
                        BorderBrush="{ThemeResource PolluxLineBrush}" Background="{ThemeResource PolluxSurfaceBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Padding="12,8" BorderBrush="{ThemeResource PolluxLineBrush}" BorderThickness="0,0,0,1">
                            <TextBlock x:Name="PreviewPaneTitle" Text="Preview" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="PreviewPaneMeta" Text="select a file" FontFamily="{StaticResource PolluxMono}" FontSize="11" Foreground="{ThemeResource PolluxMutedBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Grid x:Name="PreviewPaneContent" Grid.Row="1" />
                    </Grid>
                </Border>
            </Grid>
            <Border x:Name="TerminalHost" Grid.Row="1" Visibility="Collapsed" Margin="0,6,6,0" CornerRadius="8,8,0,0" BorderThickness="1"
                    BorderBrush="{ThemeResource PolluxLineBrush}" Background="{ThemeResource PolluxSurface2Brush}" />
            </Grid>
        </Grid>

        <!-- Quick Look preview (Space) -->
        <Border x:Name="PreviewOverlay" Grid.Row="1" Visibility="Collapsed" Margin="40,16,40,16" CornerRadius="8" BorderThickness="1"
                BorderBrush="{ThemeResource PolluxLineBrush}" Background="{ThemeResource PolluxSurface2Brush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="14,8" ColumnSpacing="12" BorderBrush="{ThemeResource PolluxLineBrush}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="PreviewTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="PreviewMeta" FontFamily="{StaticResource PolluxMono}" FontSize="11" Foreground="{ThemeResource PolluxMutedBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Space/Esc close · ↑↓ next · Enter open" VerticalAlignment="Center" FontFamily="{StaticResource PolluxMono}" FontSize="11" Foreground="{ThemeResource PolluxMutedBrush}" />
                </Grid>
                <Grid x:Name="PreviewHost" Grid.Row="1" />
            </Grid>
        </Border>

        <!-- Status bar -->
        <Grid x:Name="StatusBar" Grid.Row="2" Height="26" Padding="12,0" Background="{ThemeResource PolluxSurface2Brush}" BorderBrush="{ThemeResource PolluxLineBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="StatsPanel" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border x:Name="TransfersBadge" Visibility="Collapsed" Tapped="TransfersBadge_Tapped" Background="{ThemeResource PolluxSurfaceBrush}" BorderBrush="{ThemeResource PolluxLineBrush}" BorderThickness="1" CornerRadius="4" Padding="6,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ProgressBar x:Name="TransfersBar" Width="70" Maximum="1" VerticalAlignment="Center" />
                        <TextBlock x:Name="TransfersText" FontFamily="{StaticResource PolluxMono}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                    <FlyoutBase.AttachedFlyout>
                        <Flyout x:Name="TransfersFlyout" Placement="Top">
                            <StackPanel x:Name="TransfersPanel" Spacing="6" Width="460" />
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                </Border>
                <Border x:Name="UpdatesBadge" Visibility="Collapsed" Tapped="UpdatesBadge_Tapped" Background="{ThemeResource PolluxAccentSoftBrush}" CornerRadius="4" Padding="6,0">
                    <TextBlock x:Name="UpdatesBadgeText" FontFamily="{StaticResource PolluxMono}" FontSize="11" Foreground="{ThemeResource PolluxAccentBrush}" />
                </Border>
                <TextBlock x:Name="SelectionText" FontFamily="{StaticResource PolluxMono}" FontSize="11.5" Foreground="{ThemeResource PolluxMutedBrush}" VerticalAlignment="Center" />
                <Border BorderBrush="{ThemeResource PolluxLineBrush}" BorderThickness="1,1,1,2" CornerRadius="4" Padding="5,0">
                    <TextBlock x:Name="PaletteHint" Text="Ctrl+Shift+P" FontFamily="{StaticResource PolluxMono}" FontSize="11" Foreground="{ThemeResource PolluxMutedBrush}" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Command palette / Quick Search -->
        <Grid x:Name="PaletteOverlay" Grid.RowSpan="3" Visibility="Collapsed" Background="{ThemeResource PolluxOverlayBrush}" Tapped="PaletteOverlay_Tapped">
            <Border x:Name="PaletteCard" Width="580" MaxWidth="900" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="16,56,16,16"
                    Background="{ThemeResource PolluxSurface2Brush}" BorderBrush="{ThemeResource PolluxLineBrush}" BorderThickness="1" CornerRadius="8" Tapped="PaletteCard_Tapped">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="PaletteBox" FontFamily="{StaticResource PolluxMono}" FontSize="13" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="12,9" TextChanged="PaletteBox_TextChanged" KeyDown="PaletteBox_KeyDown" />
                    <ListView x:Name="PaletteList" Grid.Row="1" MaxHeight="440" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="PaletteList_ItemClick" Padding="0,4">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="MinHeight" Value="30" />
                                <Setter Property="Padding" Value="12,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:PaletteItem">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Detail}" Visibility="{x:Bind DetailVisibility}" FontFamily="{StaticResource PolluxMono}" FontSize="10.5" Foreground="{ThemeResource PolluxMutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Visibility="{x:Bind KeyVisibility}" VerticalAlignment="Center" BorderBrush="{ThemeResource PolluxLineBrush}" BorderThickness="1,1,1,2" CornerRadius="4" Padding="5,0">
                                        <TextBlock Text="{x:Bind KeyText}" FontFamily="{StaticResource PolluxMono}" FontSize="11" Foreground="{ThemeResource PolluxMutedBrush}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="PaletteFooter" Grid.Row="2" Margin="12,4,12,8" FontFamily="{StaticResource PolluxMono}" FontSize="11" Foreground="{ThemeResource PolluxMutedBrush}" />
                </Grid>
            </Border>
        </Grid>

        <!-- Toast -->
        <Border x:Name="Toast" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,18" Padding="14,8"
                CornerRadius="6" Background="{ThemeResource PolluxSurface2Brush}" BorderBrush="{ThemeResource PolluxLineBrush}" BorderThickness="1">
            <TextBlock x:Name="ToastText" FontFamily="{StaticResource PolluxMono}" FontSize="12" TextWrapping="Wrap" MaxWidth="600" />
        </Border>
    </Grid>
</Window>
