<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Pollux.App.Views.PaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Pollux.App.ViewModels">

    <Border x:Name="Card"
            CornerRadius="8,8,0,0"
            BorderThickness="1"
            BorderBrush="{ThemeResource PolluxLineBrush}"
            Background="{ThemeResource PolluxSurfaceBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Tabs -->
            <Grid x:Name="TabBar" Background="{ThemeResource PolluxSurface2Brush}" BorderBrush="{ThemeResource PolluxLineBrush}" BorderThickness="0,0,0,1" Padding="6,6,6,0"
                  AllowDrop="True" DragOver="TabBar_DragOver" Drop="TabBar_Drop">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TabStrip" Orientation="Horizontal" Spacing="2" />
                </ScrollViewer>
                <Button Grid.Column="1" Style="{StaticResource PolluxFlatButton}" Content="+" FontFamily="{StaticResource PolluxMono}" Foreground="{ThemeResource PolluxMutedBrush}" Padding="10,3" Margin="2,0,0,4" Click="NewTab_Click" ToolTipService.ToolTip="New tab (Ctrl+T)" />
            </Grid>

            <!-- Path bar -->
            <Grid Grid.Row="1" BorderBrush="{ThemeResource PolluxLineBrush}" BorderThickness="0,0,0,1" Padding="6,3" MinHeight="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="CrumbHost" Background="Transparent" Tapped="CrumbHost_Tapped">
                    <ScrollViewer x:Name="CrumbScroll" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="Crumbs" Orientation="Horizontal" VerticalAlignment="Center" />
                    </ScrollViewer>
                </Grid>
                <TextBox x:Name="PathBox" Visibility="Collapsed" FontFamily="{StaticResource PolluxMono}" FontSize="12" MinHeight="26" Padding="6,3" KeyDown="PathBox_KeyDown" LostFocus="PathBox_LostFocus" />
                <TextBlock x:Name="InfoText" Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0" FontFamily="{StaticResource PolluxMono}" FontSize="12" Foreground="{ThemeResource PolluxMutedBrush}" />
            </Grid>

            <!-- Filter -->
            <Border x:Name="FilterBar" Grid.Row="2" Visibility="Collapsed" Margin="8,6,8,2" Padding="8,0" CornerRadius="5" BorderThickness="1" BorderBrush="{ThemeResource PolluxAccentBrush}" Background="{ThemeResource PolluxSurface2Brush}">
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="⌕" VerticalAlignment="Center" Foreground="{ThemeResource PolluxMutedBrush}" />
                    <TextBox x:Name="FilterBox" Grid.Column="1" PlaceholderText="filter… (Esc to clear)" BorderThickness="0" Background="Transparent" FontFamily="{StaticResource PolluxMono}" FontSize="12" MinHeight="26" Padding="0,4" TextChanged="FilterBox_TextChanged" KeyDown="FilterBox_KeyDown" />
                    <TextBlock x:Name="FilterCount" Grid.Column="2" VerticalAlignment="Center" FontFamily="{StaticResource PolluxMono}" FontSize="11" Foreground="{ThemeResource PolluxMutedBrush}" />
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="3">
                <Grid x:Name="ListHost">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="Header" Background="{ThemeResource PolluxSurface2Brush}" Padding="14,0,14,0" Height="24" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="74" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SortName" Style="{StaticResource PolluxFlatButton}" Padding="0" FontSize="12" Foreground="{ThemeResource PolluxMutedBrush}" Content="Name" Click="Sort_Click" Tag="Name" />
                        <Button x:Name="SortModified" Grid.Column="1" Style="{StaticResource PolluxFlatButton}" Padding="0" FontSize="12" Foreground="{ThemeResource PolluxMutedBrush}" Content="Modified" Click="Sort_Click" Tag="Modified" />
                        <Button x:Name="SortType" Grid.Column="2" Style="{StaticResource PolluxFlatButton}" Padding="0" FontSize="12" Foreground="{ThemeResource PolluxMutedBrush}" Content="Type" Click="Sort_Click" Tag="Type" />
                        <Button x:Name="SortSize" Grid.Column="3" Style="{StaticResource PolluxFlatButton}" Padding="0" FontSize="12" Foreground="{ThemeResource PolluxMutedBrush}" Content="Size" HorizontalAlignment="Right" Click="Sort_Click" Tag="Size" />
                    </Grid>
                    <ListView x:Name="List"
                              Grid.Row="1"
                              SelectionMode="Extended"
                              IsTabStop="True"
                              TabNavigation="Once"
                              ItemContainerStyle="{StaticResource PolluxRowStyle}"
                              DoubleTapped="List_DoubleTapped"
                              RightTapped="List_RightTapped"
                              GotFocus="List_GotFocus"
                              SelectionChanged="List_SelectionChanged"
                              ContainerContentChanging="List_ContainerContentChanging"
                              CanDragItems="True"
                              DragItemsStarting="List_DragItemsStarting"
                              AllowDrop="True"
                              DragOver="List_DragOver"
                              Drop="List_Drop">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:FileItem">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="128" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="74" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                        <Grid Width="16" Height="16">
                                            <Border Visibility="{x:Bind FolderVisibility}" Background="{ThemeResource PolluxFolderBrush}" CornerRadius="2,4,3,3" Height="12" Margin="0,2,0,0" />
                                            <Border Visibility="{x:Bind BadgeVisibility}" BorderBrush="{ThemeResource PolluxLineBrush}" Background="{ThemeResource PolluxSurface2Brush}" BorderThickness="1" CornerRadius="3">
                                                <TextBlock Text="{x:Bind Badge}" FontFamily="{StaticResource PolluxMono}" FontSize="7.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource PolluxMutedBrush}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock x:Name="NameText" Text="{x:Bind Name}" Opacity="{x:Bind NameOpacity}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="13" />
                                        <TextBlock Text="{x:Bind CloudGlyph}" FontSize="10" VerticalAlignment="Center" Foreground="{ThemeResource PolluxMutedBrush}" />
                                        <TextBlock Text="{x:Bind GitText}" FontFamily="{StaticResource PolluxMono}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{x:Bind GitBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ModifiedText}" FontFamily="{StaticResource PolluxMono}" FontSize="12" Foreground="{ThemeResource PolluxMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind TypeText}" FontFamily="{StaticResource PolluxMono}" FontSize="12" Foreground="{ThemeResource PolluxMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind SizeText}" FontFamily="{StaticResource PolluxMono}" FontSize="12" Foreground="{ThemeResource PolluxMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyText" Grid.Row="1" Visibility="Collapsed" IsHitTestVisible="False" Margin="20" FontFamily="{StaticResource PolluxMono}" FontSize="12" Foreground="{ThemeResource PolluxMutedBrush}" TextWrapping="Wrap" />
                </Grid>
                <ScrollViewer x:Name="HomeHost" Visibility="Collapsed" Padding="18,12">
                    <StackPanel x:Name="HomePanel" Spacing="6" />
                </ScrollViewer>
                <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" VerticalAlignment="Top" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
