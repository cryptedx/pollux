<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Pollux.App.Views.PaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Pollux.App.ViewModels"
    xmlns:views="using:Pollux.App.Views">

    <UserControl.Resources>
        <!-- Tiles and Large Icons: ListViews of their own with a wrapping panel, so keyboard and selection work alike in every view mode.
             Template layout is read by ShowThumbnail: root.Children[0] is the icon grid = [fallback, thumbnail image]. -->
        <Style x:Key="PolluxTileStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <ItemsPanelTemplate x:Key="PolluxTilesPanel">
            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="264" ItemHeight="64" Margin="4,4,4,0" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="PolluxIconsPanel">
            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="124" ItemHeight="148" Margin="4,4,4,0" />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="PolluxTileTemplate" x:DataType="vm:FileItem">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="48" Height="48" VerticalAlignment="Center">
                    <Grid>
                        <Image Source="{x:Bind Icon, Mode=OneWay}" Width="48" Height="48" Stretch="Uniform" />
                        <Grid Visibility="{x:Bind IconFallbackVisibility, Mode=OneWay}">
                        <Border Visibility="{x:Bind FolderVisibility}" Background="{ThemeResource PolluxFolderBrush}" CornerRadius="3,6,4,4" Width="40" Height="30" />
                        <Border Visibility="{x:Bind BadgeVisibility}" BorderBrush="{ThemeResource PolluxLineBrush}" Background="{ThemeResource PolluxSurface2Brush}" BorderThickness="1" CornerRadius="4" Width="36" Height="44">
                            <TextBlock Text="{x:Bind Badge}" FontFamily="{StaticResource PolluxMono}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource PolluxMutedBrush}" />
                        </Border>
                        </Grid>
                    </Grid>
                    <Image Stretch="Uniform" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="{x:Bind Name}" Opacity="{x:Bind NameOpacity}" TextTrimming="CharacterEllipsis" FontSize="13" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind TypeText}" FontFamily="{StaticResource PolluxMono}" FontSize="11" Foreground="{ThemeResource PolluxMutedBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind SizeText, Mode=OneWay}" FontFamily="{StaticResource PolluxMono}" FontSize="11" Foreground="{ThemeResource PolluxMutedBrush}" />
                        <TextBlock Text="{x:Bind CloudGlyph}" FontSize="10" Foreground="{ThemeResource PolluxMutedBrush}" />
                        <TextBlock Text="{x:Bind GitText}" FontFamily="{StaticResource PolluxMono}" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind GitBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="PolluxIconTemplate" x:DataType="vm:FileItem">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="96" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Width="96" Height="96" HorizontalAlignment="Center">
                    <Grid>
                        <Image Source="{x:Bind Icon, Mode=OneWay}" Width="72" Height="72" Stretch="Uniform" />
                        <Grid Visibility="{x:Bind IconFallbackVisibility, Mode=OneWay}">
                        <Border Visibility="{x:Bind FolderVisibility}" Background="{ThemeResource PolluxFolderBrush}" CornerRadius="5,10,7,7" Width="80" Height="60" />
                        <Border Visibility="{x:Bind BadgeVisibility}" BorderBrush="{ThemeResource PolluxLineBrush}" Background="{ThemeResource PolluxSurface2Brush}" BorderThickness="1" CornerRadius="6" Width="68" Height="88">
                            <TextBlock Text="{x:Bind Badge}" FontFamily="{StaticResource PolluxMono}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource PolluxMutedBrush}" />
                        </Border>
                        </Grid>
                    </Grid>
                    <Image Stretch="Uniform" />
                </Grid>
                <TextBlock Grid.Row="1" Text="{x:Bind Name}" Opacity="{x:Bind NameOpacity}" FontSize="12" TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border x:Name="Card"
            CornerRadius="8,8,0,0"
            BorderThickness="1"
            BorderBrush="{ThemeResource PolluxLineBrush}"
            Background="{ThemeResource PolluxSurfaceBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Tabs -->
            <Grid x:Name="TabBar" Background="{ThemeResource PolluxSurface2Brush}" BorderBrush="{ThemeResource PolluxLineBrush}" BorderThickness="0,0,0,1" Padding="6,6,6,0"
                  AllowDrop="True" DragOver="TabBar_DragOver" Drop="TabBar_Drop">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TabStrip" Orientation="Horizontal" Spacing="2" />
                </ScrollViewer>
                <Button Grid.Column="1" Style="{StaticResource PolluxFlatButton}" Content="+" FontFamily="{StaticResource PolluxMono}" Foreground="{ThemeResource PolluxMutedBrush}" Padding="10,3" Margin="2,0,0,4" Click="NewTab_Click" ToolTipService.ToolTip="New tab (Ctrl+T)" />
            </Grid>

            <!-- Path bar -->
            <Grid Grid.Row="1" BorderBrush="{ThemeResource PolluxLineBrush}" BorderThickness="0,0,0,1" Padding="6,3" MinHeight="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="CrumbHost" Background="Transparent" Tapped="CrumbHost_Tapped">
                    <ScrollViewer x:Name="CrumbScroll" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="Crumbs" Orientation="Horizontal" VerticalAlignment="Center" />
                    </ScrollViewer>
                </Grid>
                <TextBox x:Name="PathBox" Visibility="Collapsed" FontFamily="{StaticResource PolluxMono}" FontSize="12" MinHeight="26" Padding="6,3" KeyDown="PathBox_KeyDown" LostFocus="PathBox_LostFocus" TextChanged="PathBox_TextChanged" />
                <!-- Completions under the path box; never takes focus from it. -->
                <Popup x:Name="SuggestPopup" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Border x:Name="SuggestBorder" Background="{ThemeResource PolluxSurface2Brush}" BorderBrush="{ThemeResource PolluxLineBrush}" BorderThickness="1" CornerRadius="6" PointerEntered="Suggest_PointerEntered" PointerExited="Suggest_PointerExited">
                        <ListView x:Name="SuggestList" SelectionMode="Single" IsTabStop="False" AllowFocusOnInteraction="False" MaxHeight="280" Padding="0,2" />
                    </Border>
                </Popup>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6" Margin="8,0,4,0">
                    <TextBlock x:Name="InfoText" VerticalAlignment="Center" FontFamily="{StaticResource PolluxMono}" FontSize="12" Foreground="{ThemeResource PolluxMutedBrush}" />
                    <!-- Shown only inside an untrusted repository (ADR 0006): adds its root to Trusted Folders. -->
                    <Button x:Name="TrustButton" Visibility="Collapsed" Style="{StaticResource PolluxFlatButton}" Padding="6,1" FontSize="12" Foreground="{ThemeResource PolluxAccentBrush}" Content="Trust this folder" Click="TrustButton_Click" />
                    <!-- A server or share that refused access (ADR 0010): Windows' own credential prompt, then a reload. -->
                    <Button x:Name="SignInButton" Visibility="Collapsed" Style="{StaticResource PolluxFlatButton}" Padding="6,1" FontSize="12" Foreground="{ThemeResource PolluxAccentBrush}" Content="Sign in…" Click="SignInButton_Click" />
                </StackPanel>
            </Grid>

            <!-- Filter -->
            <Border x:Name="FilterBar" Grid.Row="2" Visibility="Collapsed" Margin="8,6,8,2" Padding="8,0" CornerRadius="5" BorderThickness="1" BorderBrush="{ThemeResource PolluxAccentBrush}" Background="{ThemeResource PolluxSurface2Brush}">
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="⌕" VerticalAlignment="Center" Foreground="{ThemeResource PolluxMutedBrush}" />
                    <TextBox x:Name="FilterBox" Grid.Column="1" PlaceholderText="filter… (Esc to clear)" BorderThickness="0" Background="Transparent" FontFamily="{StaticResource PolluxMono}" FontSize="12" MinHeight="26" Padding="0,4" TextChanged="FilterBox_TextChanged" KeyDown="FilterBox_KeyDown" />
                    <TextBlock x:Name="FilterCount" Grid.Column="2" VerticalAlignment="Center" FontFamily="{StaticResource PolluxMono}" FontSize="11" Foreground="{ThemeResource PolluxMutedBrush}" />
                </Grid>
            </Border>

            <!-- Folder Search (shares the Filter's row; the two are never open together) -->
            <Border x:Name="SearchBar" Grid.Row="2" Visibility="Collapsed" Margin="8,6,8,2" Padding="8,0" CornerRadius="5" BorderThickness="1" BorderBrush="{ThemeResource PolluxAccentBrush}" Background="{ThemeResource PolluxSurface2Brush}">
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="⌕ all" VerticalAlignment="Center" FontFamily="{StaticResource PolluxMono}" FontSize="11" Foreground="{ThemeResource PolluxMutedBrush}" ToolTipService.ToolTip="Search this folder and its subfolders" />
                    <TextBox x:Name="SearchNameBox" Grid.Column="1" PlaceholderText="name, *.ext, after:7d, size&gt;1mb… (Enter)" BorderThickness="0" Background="Transparent" FontFamily="{StaticResource PolluxMono}" FontSize="12" MinHeight="26" Padding="0,4" KeyDown="SearchBox_KeyDown" />
                    <Border Grid.Column="2" Width="1" Margin="0,5" Background="{ThemeResource PolluxLineBrush}" />
                    <TextBox x:Name="SearchTextBox" Grid.Column="3" PlaceholderText="containing text…" BorderThickness="0" Background="Transparent" FontFamily="{StaticResource PolluxMono}" FontSize="12" MinHeight="26" Padding="0,4" KeyDown="SearchBox_KeyDown" />
                    <TextBlock x:Name="SearchStatus" Grid.Column="4" VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource PolluxMono}" FontSize="11" Foreground="{ThemeResource PolluxMutedBrush}" />
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="3">
                <Grid x:Name="ListHost">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- Header and rows share one column layout (PaneView.Columns.cs): DetailsColumnsPanel places each cell by its ColumnId. -->
                    <views:DetailsHeader x:Name="Header" Background="{ThemeResource PolluxSurface2Brush}" Padding="14,0,14,0" Height="24" RightTapped="Header_RightTapped" />
                    <ListView x:Name="DetailsList"
                              Grid.Row="1"
                              SelectionMode="Extended"
                              IsTabStop="True"
                              TabNavigation="Once"
                              ItemContainerStyle="{StaticResource PolluxRowStyle}"
                              DoubleTapped="List_DoubleTapped"
                              RightTapped="List_RightTapped"
                              GotFocus="List_GotFocus"
                              SelectionChanged="List_SelectionChanged"
                              ContainerContentChanging="List_ContainerContentChanging"
                              CanDragItems="True"
                              DragItemsStarting="List_DragItemsStarting"
                              AllowDrop="True"
                              DragOver="List_DragOver"
                              DragLeave="List_DragLeave"
                              Drop="List_Drop">
                        <!-- The header shows the group's ToString(): a binding to the group does not resolve in the header template. -->
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderContainerStyle>
                                    <Style TargetType="ListViewHeaderItem">
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="Padding" Value="14,6,0,2" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{ThemeResource PolluxMutedBrush}" />
                                    </Style>
                                </GroupStyle.HeaderContainerStyle>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:FileItem">
                                <!-- Children[0] is the Name cell (search highlights in List_ContainerContentChanging); one cell per known column. -->
                                <views:DetailsColumnsPanel>
                                    <StackPanel views:DetailsColumnsPanel.ColumnId="name" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                        <Grid Width="16" Height="16">
                                            <Image Source="{x:Bind Icon, Mode=OneWay}" Width="16" Height="16" Stretch="Uniform" />
                                            <Grid Visibility="{x:Bind IconFallbackVisibility, Mode=OneWay}">
                                            <Border Visibility="{x:Bind FolderVisibility}" Background="{ThemeResource PolluxFolderBrush}" CornerRadius="2,4,3,3" Height="12" Margin="0,2,0,0" />
                                            <Border Visibility="{x:Bind BadgeVisibility}" BorderBrush="{ThemeResource PolluxLineBrush}" Background="{ThemeResource PolluxSurface2Brush}" BorderThickness="1" CornerRadius="3">
                                                <TextBlock Text="{x:Bind Badge}" FontFamily="{StaticResource PolluxMono}" FontSize="7.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource PolluxMutedBrush}" />
                                            </Border>
                                            </Grid>
                                        </Grid>
                                        <TextBlock x:Name="NameText" Text="{x:Bind Name}" ToolTipService.ToolTip="{x:Bind LinkTip}" Opacity="{x:Bind NameOpacity}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="13" />
                                        <TextBlock Text="{x:Bind CloudGlyph}" FontSize="10" VerticalAlignment="Center" Foreground="{ThemeResource PolluxMutedBrush}" />
                                        <TextBlock Text="{x:Bind GitText}" FontFamily="{StaticResource PolluxMono}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{x:Bind GitBrush}" />
                                        <TextBlock Text="{x:Bind CompareText, Mode=OneWay}" Visibility="{x:Bind CompareVisibility, Mode=OneWay}" FontFamily="{StaticResource PolluxMono}" FontSize="10.5" VerticalAlignment="Center" Foreground="{x:Bind CompareBrush, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind OriginText}" Visibility="{x:Bind OriginVisibility}" FontFamily="{StaticResource PolluxMono}" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource PolluxMutedBrush}" />
                                    </StackPanel>
                                    <TextBlock views:DetailsColumnsPanel.ColumnId="modified" Text="{x:Bind ModifiedText}" FontFamily="{StaticResource PolluxMono}" FontSize="12" Foreground="{ThemeResource PolluxMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock views:DetailsColumnsPanel.ColumnId="type" Text="{x:Bind TypeText}" FontFamily="{StaticResource PolluxMono}" FontSize="12" Foreground="{ThemeResource PolluxMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock views:DetailsColumnsPanel.ColumnId="size" Text="{x:Bind SizeText, Mode=OneWay}" TextAlignment="Right" FontFamily="{StaticResource PolluxMono}" FontSize="12" Foreground="{ThemeResource PolluxMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock views:DetailsColumnsPanel.ColumnId="created" Text="{x:Bind CreatedText}" FontFamily="{StaticResource PolluxMono}" FontSize="12" Foreground="{ThemeResource PolluxMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock views:DetailsColumnsPanel.ColumnId="attributes" Text="{x:Bind AttributesText}" FontFamily="{StaticResource PolluxMono}" FontSize="12" Foreground="{ThemeResource PolluxMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock views:DetailsColumnsPanel.ColumnId="extension" Text="{x:Bind ExtensionText}" FontFamily="{StaticResource PolluxMono}" FontSize="12" Foreground="{ThemeResource PolluxMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock views:DetailsColumnsPanel.ColumnId="dimensions" Text="{x:Bind DimensionsText, Mode=OneWay}" TextAlignment="Right" FontFamily="{StaticResource PolluxMono}" FontSize="12" Foreground="{ThemeResource PolluxMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock views:DetailsColumnsPanel.ColumnId="duration" Text="{x:Bind DurationText, Mode=OneWay}" TextAlignment="Right" FontFamily="{StaticResource PolluxMono}" FontSize="12" Foreground="{ThemeResource PolluxMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock views:DetailsColumnsPanel.ColumnId="authors" Text="{x:Bind AuthorsText, Mode=OneWay}" FontFamily="{StaticResource PolluxMono}" FontSize="12" Foreground="{ThemeResource PolluxMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock views:DetailsColumnsPanel.ColumnId="title" Text="{x:Bind TitleText, Mode=OneWay}" FontFamily="{StaticResource PolluxMono}" FontSize="12" Foreground="{ThemeResource PolluxMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock views:DetailsColumnsPanel.ColumnId="fileVersion" Text="{x:Bind FileVersionText, Mode=OneWay}" FontFamily="{StaticResource PolluxMono}" FontSize="12" Foreground="{ThemeResource PolluxMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock views:DetailsColumnsPanel.ColumnId="company" Text="{x:Bind CompanyText, Mode=OneWay}" FontFamily="{StaticResource PolluxMono}" FontSize="12" Foreground="{ThemeResource PolluxMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock views:DetailsColumnsPanel.ColumnId="dateTaken" Text="{x:Bind DateTakenText, Mode=OneWay}" FontFamily="{StaticResource PolluxMono}" FontSize="12" Foreground="{ThemeResource PolluxMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </views:DetailsColumnsPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <!-- One ListView per view mode with fixed panel, template and style: nothing is swapped on a live ListView. -->
                    <ListView x:Name="TilesList" Grid.Row="1" Visibility="Collapsed"
                              ItemsPanel="{StaticResource PolluxTilesPanel}"
                              ItemContainerStyle="{StaticResource PolluxTileStyle}"
                              ItemTemplate="{StaticResource PolluxTileTemplate}"
                              SelectionMode="Extended"
                              IsTabStop="True"
                              TabNavigation="Once"
                              DoubleTapped="List_DoubleTapped"
                              RightTapped="List_RightTapped"
                              GotFocus="List_GotFocus"
                              SelectionChanged="List_SelectionChanged"
                              ContainerContentChanging="List_ContainerContentChanging"
                              CanDragItems="True"
                              DragItemsStarting="List_DragItemsStarting"
                              AllowDrop="True"
                              DragOver="List_DragOver"
                              DragLeave="List_DragLeave"
                              Drop="List_Drop" />
                    <ListView x:Name="IconsList" Grid.Row="1" Visibility="Collapsed"
                              ItemsPanel="{StaticResource PolluxIconsPanel}"
                              ItemContainerStyle="{StaticResource PolluxTileStyle}"
                              ItemTemplate="{StaticResource PolluxIconTemplate}"
                              SelectionMode="Extended"
                              IsTabStop="True"
                              TabNavigation="Once"
                              DoubleTapped="List_DoubleTapped"
                              RightTapped="List_RightTapped"
                              GotFocus="List_GotFocus"
                              SelectionChanged="List_SelectionChanged"
                              ContainerContentChanging="List_ContainerContentChanging"
                              CanDragItems="True"
                              DragItemsStarting="List_DragItemsStarting"
                              AllowDrop="True"
                              DragOver="List_DragOver"
                              DragLeave="List_DragLeave"
                              Drop="List_Drop" />
                    <!-- Rubber-band selection (MarqueeSelection) draws over the shown list. -->
                    <Canvas x:Name="MarqueeLayer" Grid.Row="1" IsHitTestVisible="False" />
                    <TextBlock x:Name="EmptyText" Grid.Row="1" Visibility="Collapsed" IsHitTestVisible="False" Margin="20" FontFamily="{StaticResource PolluxMono}" FontSize="12" Foreground="{ThemeResource PolluxMutedBrush}" TextWrapping="Wrap" />
                </Grid>
                <ScrollViewer x:Name="HomeHost" Visibility="Collapsed" Padding="18,12">
                    <StackPanel x:Name="HomePanel" Spacing="6" />
                </ScrollViewer>
                <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" VerticalAlignment="Top" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
