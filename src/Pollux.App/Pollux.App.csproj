<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <RootNamespace>Pollux.App</RootNamespace>
    <AssemblyName>Pollux</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\pollux.ico</ApplicationIcon>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Version>1.3.0</Version>
    <Product>Pollux</Product>

    <!-- Unpackaged, self-contained, per-user install without admin (ADR 0002). -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- Needed even unpackaged: generates Pollux.pri and copies .xbf/.pri into the publish output. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Ship only English and German UI resources of the frameworks (keeps the install folder smaller). -->
    <SatelliteResourceLanguages>en;de</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Native AOT + trimming for startup time (ADR 0002). -->
  <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <!-- Referenced here (not only via Pollux.Copilot) so its MSBuild targets download the pinned Copilot CLI for
         this build's RID (win-x64 / win-arm64), SHA256-checked, into runtimes\<rid>\native (ADR 0005). -->
    <PackageReference Include="GitHub.Copilot.SDK" />
  </ItemGroup>

  <!-- Bundled Copilot CLI (ADR 0005), after the SDK's _RegisterCopilotCliForCopy has listed its files:
       - ship the CLI license next to it (its redistribution terms require a copy);
       - drop copilot_runtime.dll, the SDK's renamed copy of runtime.node for in-process hosting (~95 MB).
         Pollux only talks to the CLI over stdio, where copilot-runtime.exe loads runtime.node itself. -->
  <Target Name="_PolluxCopilotCliPayload" AfterTargets="_RegisterCopilotCliForCopy" Condition="'$(_CopilotRid)' != '' And '$(CopilotSkipCliDownload)' != 'true'">
    <PropertyGroup>
      <_PolluxCopilotNative>runtimes\$(_CopilotRid)\native</_PolluxCopilotNative>
    </PropertyGroup>
    <Error Condition="!Exists('$(_CopilotCacheDir)\LICENSE.md')" Text="Copilot CLI license not found at '$(_CopilotCacheDir)\LICENSE.md'." />
    <ItemGroup>
      <!-- Matched by target path: its source file is runtime.node, which must stay. -->
      <_PolluxCopilotDrop Include="@(ContentWithTargetPath)" Condition="'%(ContentWithTargetPath.TargetPath)' == '$(_PolluxCopilotNative)\copilot_runtime.dll'" />
      <ContentWithTargetPath Remove="@(_PolluxCopilotDrop)" MatchOnMetadata="TargetPath" />
      <ContentWithTargetPath Include="$(_CopilotCacheDir)\LICENSE.md" TargetPath="$(_PolluxCopilotNative)\LICENSE.md"
                             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Pollux.Core\Pollux.Core.csproj" />
    <ProjectReference Include="..\Pollux.Copilot\Pollux.Copilot.csproj" />
  </ItemGroup>
</Project>
