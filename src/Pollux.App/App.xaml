<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Pollux.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PolluxSurfaceBrush" Color="#CCFFFFFF" />
                    <SolidColorBrush x:Key="PolluxSurface2Brush" Color="#F7F7F7" />
                    <SolidColorBrush x:Key="PolluxChromeBrush" Color="#00FFFFFF" />
                    <SolidColorBrush x:Key="PolluxLineBrush" Color="#E3E3E3" />
                    <SolidColorBrush x:Key="PolluxTextBrush" Color="#1B1B1B" />
                    <SolidColorBrush x:Key="PolluxMutedBrush" Color="#6B6B6B" />
                    <SolidColorBrush x:Key="PolluxAccentBrush" Color="{ThemeResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="PolluxAccentSoftBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.12" />
                    <SolidColorBrush x:Key="PolluxHoverBrush" Color="#0A000000" />
                    <SolidColorBrush x:Key="PolluxFolderBrush" Color="#D9A22C" />
                    <SolidColorBrush x:Key="PolluxBadBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="PolluxGoodBrush" Color="#2E8B57" />
                    <SolidColorBrush x:Key="PolluxWarnBrush" Color="#C27C0E" />
                    <SolidColorBrush x:Key="PolluxOverlayBrush" Color="#33000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PolluxSurfaceBrush" Color="#CC272727" />
                    <SolidColorBrush x:Key="PolluxSurface2Brush" Color="#2C2C2C" />
                    <SolidColorBrush x:Key="PolluxChromeBrush" Color="#00000000" />
                    <SolidColorBrush x:Key="PolluxLineBrush" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="PolluxTextBrush" Color="#E9E9E9" />
                    <SolidColorBrush x:Key="PolluxMutedBrush" Color="#9A9A9A" />
                    <SolidColorBrush x:Key="PolluxAccentBrush" Color="{ThemeResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="PolluxAccentSoftBrush" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.14" />
                    <SolidColorBrush x:Key="PolluxHoverBrush" Color="#0DFFFFFF" />
                    <SolidColorBrush x:Key="PolluxFolderBrush" Color="#E8B84A" />
                    <SolidColorBrush x:Key="PolluxBadBrush" Color="#FF7B72" />
                    <SolidColorBrush x:Key="PolluxGoodBrush" Color="#6CCB8F" />
                    <SolidColorBrush x:Key="PolluxWarnBrush" Color="#F0B94A" />
                    <SolidColorBrush x:Key="PolluxOverlayBrush" Color="#55000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <FontFamily x:Key="PolluxMono">Cascadia Mono, Cascadia Code, Consolas</FontFamily>
            <FontFamily x:Key="PolluxUi">Segoe UI Variable Text, Segoe UI</FontFamily>

            <Style x:Key="PolluxFlatButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="CornerRadius" Value="5" />
            </Style>

            <Style x:Key="PolluxRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Margin" Value="4,0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
